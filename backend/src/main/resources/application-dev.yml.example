# Copy this file to `application-dev.yml` and fill in real values.
# `application-dev.yml` is gitignored and must never be committed.

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/invoicepe
    username: <YOUR_DB_USERNAME>
    password: <YOUR_DB_PASSWORD>
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

app:
  jwt:
    secret: <YOUR_JWT_SECRET_MIN_32_CHARS>  # Must be ≥32 characters for HS256
    expiration: 86400000        # 24 hours in ms
  frontend-url: http://localhost:3000
  storage:
    supabase-url: <YOUR_SUPABASE_PROJECT_URL>
    supabase-key: <YOUR_SUPABASE_ANON_KEY>
    bucket-name: invoices

razorpay:
  key-id: <YOUR_RAZORPAY_KEY_ID>
  key-secret: <YOUR_RAZORPAY_KEY_SECRET>
  webhook-secret: <YOUR_RAZORPAY_WEBHOOK_SECRET>
  plans:
    pro: <RAZORPAY_PLAN_ID_PRO>
    business: <RAZORPAY_PLAN_ID_BUSINESS>

whatsapp:
  phone-number-id: <YOUR_WHATSAPP_PHONE_NUMBER_ID>
  access-token: <YOUR_META_ACCESS_TOKEN>
  api-url: https://graph.facebook.com/v18.0

resend:
  api-key: <YOUR_RESEND_API_KEY>
  from-email: invoices@invoicepe.in
  from-name: InvoicePe
